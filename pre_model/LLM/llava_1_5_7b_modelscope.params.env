# LLaVA-1.5-7B download parameters.
# The download script in ../../work_scripts reads this file by default.

# ModelScope repository in Hugging Face Transformers format.
MODELSCOPE_MODEL_ID="swift/llava-1.5-7b-hf"
MODELSCOPE_REVISION="master"

# Local directory under EnAR/pre_model/LLM.
MODEL_LOCAL_DIR="llava-1.5-7b-hf"

# Set to "1" when your network/proxy injects a self-signed certificate and
# ModelScope fails with CERTIFICATE_VERIFY_FAILED.
MODELSCOPE_DISABLE_SSL_VERIFY="1"
