# Stable Diffusion v1.5 pretrained model download parameters.
# The download script in ../../work_scripts reads this file by default.

# Download backend: "modelscope" is recommended for mainland China because
# hf-mirror.com redirects this repo's LFS weight files back to huggingface.co.
DOWNLOAD_BACKEND="modelscope"

# Hugging Face model repository.
MODEL_REPO_ID="stable-diffusion-v1-5/stable-diffusion-v1-5"
MODEL_REVISION="main"

# ModelScope mirror repository with the same Diffusers Stable Diffusion v1.5 layout.
MODELSCOPE_MODEL_ID="AI-ModelScope/stable-diffusion-v1-5"
MODELSCOPE_REVISION="master"

# Set to "1" only when your network/proxy injects a self-signed certificate and
# ModelScope fails with CERTIFICATE_VERIFY_FAILED.
MODELSCOPE_DISABLE_SSL_VERIFY="1"

# Local directory under EnAR/pre_model/DDIM.
MODEL_LOCAL_DIR="stable-diffusion-v1-5"

# Optional Hugging Face settings.
# HF_TOKEN can also be exported in the shell before running the script.
HF_TOKEN=""

# Mainland China downloads are usually much faster through hf-mirror.com.
# Change this back to "https://huggingface.co" if the mirror is unavailable.
HF_ENDPOINT="https://hf-mirror.com"

# Sequential download mode is more stable on flaky mirrors/proxies.
HF_DOWNLOAD_MAX_WORKERS="1"

# New high performance transfer switch used by recent huggingface_hub versions.
HF_XET_HIGH_PERFORMANCE="1"

# Download the diffusers layout with safetensors weights and scheduler/config files.
# This keeps the folder usable by diffusers while avoiding duplicate .ckpt/.bin files.
HF_ALLOW_PATTERNS="model_index.json,README.md,*.json,*.txt,*.safetensors,tokenizer/*,text_encoder/*,unet/*,vae/*,scheduler/*,feature_extractor/*,safety_checker/*"
HF_IGNORE_PATTERNS="*.ckpt,*.bin,*.msgpack,*.onnx,*.tflite,*.h5,*.pth,*.pt"

# Fixed file list avoids the Hugging Face metadata API, which can redirect from
# hf-mirror.com to huggingface.co and fail on unstable networks.
HF_FILE_LIST="README.md,model_index.json,feature_extractor/preprocessor_config.json,safety_checker/config.json,safety_checker/model.fp16.safetensors,safety_checker/model.safetensors,scheduler/scheduler_config.json,text_encoder/config.json,text_encoder/model.fp16.safetensors,text_encoder/model.safetensors,tokenizer/merges.txt,tokenizer/special_tokens_map.json,tokenizer/tokenizer_config.json,tokenizer/vocab.json,unet/config.json,unet/diffusion_pytorch_model.fp16.safetensors,unet/diffusion_pytorch_model.safetensors,vae/config.json,vae/diffusion_pytorch_model.fp16.safetensors,vae/diffusion_pytorch_model.safetensors"
